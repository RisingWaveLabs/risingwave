# `let` and `${...}` references below require substitution to be enabled.
control substitution on

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
CREATE TABLE t (k INT, ts INT, v INT, WATERMARK FOR ts AS ts - 5) APPEND ONLY;

# All window frames are bounded `ROWS` frames with at most 2 preceding rows and 1 following row,
# so at most 3 rows below the watermark are retained in each partition.
statement ok
CREATE MATERIALIZED VIEW mv AS
SELECT
    k, ts, v,
    lag(v, 1) OVER (PARTITION BY k ORDER BY ts) AS lag_v,
    lead(v, 1) OVER (PARTITION BY k ORDER BY ts) AS lead_v,
    sum(v) OVER (PARTITION BY k ORDER BY ts ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) AS sum_v
FROM t;

let internal_table_name
SELECT name FROM rw_catalog.rw_internal_table_info WHERE job_name = 'mv' AND name LIKE '%overwindow%';

statement ok
INSERT INTO t VALUES (1, 10, 1), (1, 20, 2), (1, 30, 3), (1, 40, 4);

statement ok
INSERT INTO t VALUES (1, 50, 5), (1, 60, 6);

query IIIIII
SELECT * FROM mv ORDER BY k, ts;
----
1 10 1 NULL 2 1
1 20 2 1 3 3
1 30 3 2 4 6
1 40 4 3 5 9
1 50 5 4 6 12
1 60 6 5 NULL 15

# Push the watermark to 75 with another partition. Partition 1 is not touched, so its last
# watermark-delay window is retained until it's accessed again.
statement ok
INSERT INTO t VALUES (2, 80, 100);

query I retry 30 backoff 1s
SELECT count(*) FROM ${internal_table_name};
----
5

# Rows arriving afterwards are computed against the retained rows.
statement ok
INSERT INTO t VALUES (1, 77, 7);

query IIIIII
SELECT * FROM mv ORDER BY k, ts;
----
1 10 1 NULL 2 1
1 20 2 1 3 3
1 30 3 2 4 6
1 40 4 3 5 9
1 50 5 4 6 12
1 60 6 5 7 15
1 77 7 6 NULL 18
2 80 100 NULL NULL 100

query I
SELECT count(*) FROM ${internal_table_name};
----
5

# Push the watermark to 95 with partition 2. Partition 1 is not touched and therefore isn't
# cleaned at this barrier.
statement ok
INSERT INTO t VALUES (2, 100, 200);

query IIIIII
SELECT * FROM mv ORDER BY k, ts;
----
1 10 1 NULL 2 1
1 20 2 1 3 3
1 30 3 2 4 6
1 40 4 3 5 9
1 50 5 4 6 12
1 60 6 5 7 15
1 77 7 6 NULL 18
2 80 100 NULL 200 100
2 100 200 100 NULL 300

query I retry 30 backoff 1s
SELECT count(*) FROM ${internal_table_name};
----
6

statement ok
DROP MATERIALIZED VIEW mv;

statement ok
DROP TABLE t;
