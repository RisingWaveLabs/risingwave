control substitution on

system ok
psql -c "
    SELECT pg_terminate_backend(active_pid)
    FROM pg_replication_slots
    WHERE slot_name = 'pg_auto_schema_change_type_compat_slot' AND active_pid IS NOT NULL;
    SELECT pg_sleep(1);
    SELECT pg_drop_replication_slot(slot_name)
    FROM pg_replication_slots
    WHERE slot_name = 'pg_auto_schema_change_type_compat_slot';
    DROP TABLE IF EXISTS pg_auto_schema_change_type_compat;
"

system ok
psql -c "
    CREATE TABLE pg_auto_schema_change_type_compat (
        id int PRIMARY KEY,
        amount numeric,
        note varchar
    );
    INSERT INTO pg_auto_schema_change_type_compat VALUES
        (1, 57896044618658097711785492504343953926634992332820282019728792003956564819967, 'before');
"

statement ok
create source s_pg_auto_schema_change_type_compat with (
  connector = 'postgres-cdc',
  hostname = '${PGHOST:localhost}',
  port = '${PGPORT:5432}',
  username = '${PGUSER:$USER}',
  password = '${PGPASSWORD:}',
  database.name = '${PGDATABASE:postgres}',
  schema.name = 'public',
  slot.name = 'pg_auto_schema_change_type_compat_slot',
  auto.schema.change = 'true'
);

statement ok
create table rw_pg_auto_schema_change_int256 (
  id int,
  amount rw_int256,
  note varchar,
  primary key (id)
) from s_pg_auto_schema_change_type_compat table 'public.pg_auto_schema_change_type_compat';

statement ok
create table rw_pg_auto_schema_change_varchar (
  id int,
  amount varchar,
  note varchar,
  primary key (id)
) from s_pg_auto_schema_change_type_compat table 'public.pg_auto_schema_change_type_compat';

query TTT retry 10 backoff 1s
select id, amount, note from rw_pg_auto_schema_change_int256 order by id;
