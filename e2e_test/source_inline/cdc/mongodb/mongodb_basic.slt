# CDC source basic test
control substitution on

statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table phases (name varchar primary key, at timestamptz);

statement ok
insert into phases values ('00_begin', now());

# Test invalid MongoDB URL - should fail during validation
statement error Failed to connect to MongoDB
CREATE TABLE users_invalid (_id JSONB PRIMARY KEY, payload JSONB)
INCLUDE TIMESTAMP as commit_ts
INCLUDE DATABASE_NAME as database_name
INCLUDE COLLECTION_NAME as collection_name
WITH (
  connector = 'mongodb-cdc',
  mongodb.url = 'mongodb://wrong-host:27017/?replicaSet=rs0',
  collection.name = 'random_data.*'
);

# A regular-expression collection filter does not trigger database inference, so Debezium
# still discovers every database and the limited user cannot list collections in config.
statement error Failed to discover MongoDB collections with the configured user:.*not authorized on config to execute command.*listCollections
CREATE TABLE users_insufficient_discovery_privilege (
  _id JSONB PRIMARY KEY,
  payload JSONB
) WITH (
  connector = 'mongodb-cdc',
  mongodb.url = 'mongodb://rw_limited:risingwave@mongodb-auth:27017/?replicaSet=rs-auth&authSource=admin',
  collection.name = 'rw_allowed[.]events'
);

# An unambiguous literal collection list infers Debezium's database include list and literal
# match mode at runtime, avoiding discovery of databases that the limited user cannot access.
statement ok
CREATE TABLE users_inferred_database_list (
  _id JSONB PRIMARY KEY,
  payload JSONB
) WITH (
  connector = 'mongodb-cdc',
  mongodb.url = 'mongodb://rw_limited:risingwave@mongodb-auth:27017/?replicaSet=rs-auth&authSource=admin',
  collection.name = 'rw_allowed.events'
);

query I retry 20 backoff 1s
SELECT count(*) FROM users_inferred_database_list;
----
1

statement ok
DROP TABLE users_inferred_database_list;

# Restricting Debezium's database discovery to the authorized database avoids touching
# config and allows both validation and ingestion to proceed.
statement ok
CREATE TABLE users_restricted_database_discovery (
  _id JSONB PRIMARY KEY,
  payload JSONB
) WITH (
  connector = 'mongodb-cdc',
  mongodb.url = 'mongodb://rw_limited:risingwave@mongodb-auth:27017/?replicaSet=rs-auth&authSource=admin',
  collection.name = 'rw_allowed.events',
  debezium.database.include.list = 'rw_allowed'
);

query I retry 20 backoff 1s
SELECT count(*) FROM users_restricted_database_discovery;
----
1

statement ok
DROP TABLE users_restricted_database_discovery;

system ok
mongosh 'mongodb://mongodb:27017' <<EOF
db.all_types.insertOne({
  _id: ObjectId('6911a33502454e0f774f8803'),
  f01a_double   : Double(2.5),
  // f01b_double   : Double('-Infinity'), // #21414
  f02_string    : 'Rising',
  f03_object    : {foo: true, bar: false},
  f04_array     : ['e0', 'e1'],
  f05a_binData  : Binary.createFromHexString('deadbeef'),
  f05b_binData  : UUID('00112233-4455-6677-8899-aabbccddeeff'),
  f05c_binData  : Binary.fromFloat32Array(new Float32Array([2, 3])),
  // f06_undefined           // deprecated
  // f07_objectId            // see _id
  f08_bool      : false,
  f09a_date     : ISODate(1),
  f09b_date     : ISODate('1965-08-09T02:00:00Z'),
  f10_null      : null,
  f11_regex     : /ab+c/i,
  // f12_dbPointer           // deprecated
  f13_javascript: Code("function() {}"),
  // f14_symbol              // deprecated
  // f15_javascriptWithScope // deprecated
  f16_int       : Int32(42),
  f17_timestamp : Timestamp({'t': 4, 'i': 7}),
  f18_long      : Long('9007199254740993'),
  f19_decimal   : Decimal128('0.12345678901234567'),
});
EOF


statement ok
insert into phases values ('01_inserted', now());

statement ok
CREATE TABLE all_types_extjson (_id JSONB PRIMARY KEY, payload JSONB)
INCLUDE TIMESTAMP as commit_ts
INCLUDE DATABASE_NAME as database_name
INCLUDE COLLECTION_NAME as collection_name
WITH (
  connector = 'mongodb-cdc',
  mongodb.url = 'mongodb://mongodb:27017/?replicaSet=rs0',
  collection.name = 'test.all_types'
);

statement ok
insert into phases values ('02_created', now());

statement ok
CREATE MATERIALIZED VIEW all_types_access AS
WITH per_field AS (SELECT *, unnest(ARRAY[
  'f01a_double',
  -- 'f01b_double',
  'f02_string',
  'f03_object',
  'f04_array',
  'f05a_binData',
  'f05b_binData',
  'f05c_binData',
  'f08_bool',
  'f09a_date',
  'f09b_date',
  'f10_null',
  'f11_regex',
  'f13_javascript',
  'f16_int',
  'f17_timestamp',
  'f18_long',
  'f19_decimal'
]) AS field FROM all_types_extjson)
SELECT
    _id,
    field,
    payload -> field AS extjson
FROM
    per_field;

control substitution off

query TTT retry 5 backoff 1s
select _id, database_name, collection_name from all_types_extjson;
----
{"$oid": "6911a33502454e0f774f8803"} test all_types

statement ok
insert into phases values ('03_ingested', now());

