statement ok
alter table t_refresh drop column foo;

statement ok
insert into t_refresh(id, name) values (9, 'ddd'), (10, 'eee');

statement ok
flush;

sleep 20s

query IT retry 3 backoff 1s
select id, name from t_refresh order by id;
