statement ok
SET RW_IMPLICIT_FLUSH TO true;

statement ok
create table t(v1 int);

statement ok
insert into t select 1 from generate_series(1, 10000);

# trigger high barrier latency
# disable snapshot backfill because high barrier latency in snapshot backfilling jobs won't cause high barrier latency in upstream database
system ok
./risedev psql -c 'set streaming_use_snapshot_backfill = false;create materialized view m1 as select x.v1 from t x join t y using(v1);' &

sleep 1s

# first create table
system ok
./risedev psql -c 'create table t2(v1 int);' &

sleep 1s

statement error table named t2 already exists and is still being created
create table t2(v1 int);

system ok
./risedev psql -c 'drop materialized view m1;' &

query I retry 10 backoff 1s
select count(*) from rw_catalog.rw_materialized_views where name = 'm1';
