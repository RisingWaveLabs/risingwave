control substitution on

statement ok
DROP SINK IF EXISTS s6;

statement ok
DROP SINK IF EXISTS sink_agg_table;

statement ok
DROP SINK IF EXISTS sink_reserved_words;

statement ok
DROP SINK IF EXISTS sink_timestamptz_table;

statement ok
DROP SINK IF EXISTS sink_invalid_starrocks_option;

statement ok
DROP SINK IF EXISTS sink_no_permission_table;

statement ok
DROP MATERIALIZED VIEW IF EXISTS mv6;

statement ok
DROP TABLE IF EXISTS no_permission_table;

statement ok
DROP TABLE IF EXISTS t6;

statement ok
DROP TABLE IF EXISTS agg_table;

statement ok
DROP TABLE IF EXISTS reserved_words;

statement ok
DROP TABLE IF EXISTS timestamptz_table;

system ok retry 120 backoff 1s
set -o pipefail
starrocks -B --column-names -e 'SHOW BACKENDS' | awk -F '\t' 'NR == 1 { for (i = 1; i <= NF; i++) if ($i == "Alive") alive_column = i; next } alive_column && (tolower($alive_column) == "true" || $alive_column == "1") { found = 1 } END { exit !found }'

system ok
starrocks -e "
DROP DATABASE IF EXISTS ${STARROCKS_DATABASE};
CREATE DATABASE ${STARROCKS_DATABASE};
USE ${STARROCKS_DATABASE};
CREATE TABLE demo_bhv_table(v1 int,v2 smallint,v3 bigint,v4 float,v5 double,v6 string,v7 date,v8 datetime,v9 boolean,v10 json,v11 decimal(10,5)) ENGINE=OLAP
PRIMARY KEY(\`v1\`)
DISTRIBUTED BY HASH(\`v1\`) properties(\"replication_num\" = \"1\");
CREATE TABLE demo_agg_table(id int, value string REPLACE_IF_NOT_NULL) ENGINE=OLAP
AGGREGATE KEY(\`id\`)
DISTRIBUTED BY HASH(\`id\`) properties(\"replication_num\" = \"1\");
CREATE TABLE demo_reserved_words(id int, \`order\` string, \`from\` string) ENGINE=OLAP
PRIMARY KEY(id) DISTRIBUTED BY HASH (id) properties(\"replication_num\" = \"1\");
CREATE TABLE demo_timestamptz_table(id int, ts_datetime datetime, ts_varchar varchar(32), ts_char char(32), ts_string string) ENGINE=OLAP
PRIMARY KEY(id) DISTRIBUTED BY HASH (id) properties(\"replication_num\" = \"1\");
CREATE TABLE demo_permission_probe(id int) ENGINE=OLAP
PRIMARY KEY(id) DISTRIBUTED BY HASH (id) properties(\"replication_num\" = \"1\");
DROP USER IF EXISTS '${STARROCKS_USER}'@'%';
CREATE USER '${STARROCKS_USER}'@'%' IDENTIFIED BY '${STARROCKS_PASSWORD}';
GRANT ALL ON *.* TO '${STARROCKS_USER}'@'%';
DROP USER IF EXISTS 'users_no_bhv_table_priv'@'%';
CREATE USER 'users_no_bhv_table_priv'@'%' IDENTIFIED BY '${STARROCKS_PASSWORD}';
GRANT SELECT ON ${STARROCKS_DATABASE}.demo_permission_probe TO 'users_no_bhv_table_priv'@'%';
"

statement ok
set sink_decouple = false;

statement ok
CREATE TABLE no_permission_table (v1 int primary key);

statement error Unknown fields in the WITH clause
CREATE SINK sink_invalid_starrocks_option
FROM no_permission_table
WITH (
    ${RISEDEV_STARROCKS_WITH_OPTIONS_COMMON},
    type = 'upsert',
    starrocks.table = 'demo_bhv_table',
    primary_key = 'v1',
    starrocks.unknown_option = '1'
);

statement error write permission on the target table
CREATE SINK sink_no_permission_table
FROM no_permission_table
WITH (
    connector = 'starrocks',
    type = 'upsert',
    starrocks.host = '${STARROCKS_HOST}',
    starrocks.mysqlport = '${STARROCKS_QUERY_PORT}',
    starrocks.httpport = '${STARROCKS_HTTP_PORT}',
    starrocks.user = 'users_no_bhv_table_priv',
    starrocks.password = '${STARROCKS_PASSWORD}',
    starrocks.database = '${STARROCKS_DATABASE}',
    starrocks.table = 'demo_bhv_table',
    primary_key = 'v1'
);

statement ok
DROP TABLE no_permission_table;

statement ok
CREATE TABLE t6 (v1 int primary key, v2 smallint, v3 bigint, v4 real, v5 float, v6 varchar, v7 date, v8 timestamp, v9 boolean, v10 jsonb, v11 decimal);

statement ok
CREATE MATERIALIZED VIEW mv6 AS SELECT * FROM t6;

statement ok
CREATE SINK s6
FROM
    mv6 WITH (
    ${RISEDEV_STARROCKS_WITH_OPTIONS_COMMON},
    type = 'upsert',
    starrocks.table = 'demo_bhv_table',
    primary_key = 'v1'
);

# verify commit_checkpoint_interval can be altered.
statement ok
ALTER SINK s6 CONNECTOR WITH (
    commit_checkpoint_interval = '1'
);

query I
select count(*)
from rw_sinks
where name = 's6'
  and definition ILIKE '%commit_checkpoint_interval = ''1''%';
----
1

statement ok
INSERT INTO t6 VALUES (1, 1, 1, 1.1, 1.2, 'test', '2013-01-01', '2013-01-01 01:01:01' , false, '{"v101":100}',1.12345678910);

statement ok
FLUSH;

system ok retry 30 backoff 1s
starrocks -N -B -e "SELECT * FROM ${STARROCKS_DATABASE}.demo_bhv_table WHERE v1 = 1" | awk -F '\t' '{ json = $10; gsub(/[[:space:]]/, "", json); if ($1 == 1 && $2 == 1 && $3 == 1 && $4 == 1.1 && $5 == 1.2 && $6 == "test" && $7 == "2013-01-01" && $8 == "2013-01-01 01:01:01" && $9 == 0 && json == "{\"v101\":100}" && $11 == 1.12346) found = 1 } END { exit !found }'

statement ok
DROP SINK s6;

statement ok
DROP MATERIALIZED VIEW mv6;

statement ok
DROP TABLE t6;

statement ok
CREATE TABLE agg_table(id int primary key, value string);

statement ok
CREATE SINK sink_agg_table
FROM
    agg_table WITH (
    ${RISEDEV_STARROCKS_WITH_OPTIONS_COMMON},
    type = 'append-only',
    force_append_only='true',
    starrocks.table = 'demo_agg_table',
    primary_key = 'id'
);

statement ok
INSERT INTO agg_table VALUES (1, 'v');

statement ok
FLUSH;

system ok retry 30 backoff 1s
test "$(starrocks -N -B -e "SELECT count(*) FROM ${STARROCKS_DATABASE}.demo_agg_table WHERE id = 1 AND value = 'v'")" = "1"

statement ok
DROP SINK sink_agg_table;

statement ok
DROP TABLE agg_table;

statement ok
CREATE TABLE reserved_words (id int primary key, "order" text, "from" text);

statement ok
CREATE SINK sink_reserved_words
FROM reserved_words
WITH (
    ${RISEDEV_STARROCKS_WITH_OPTIONS_COMMON},
    type = 'upsert',
    starrocks.table = 'demo_reserved_words',
    primary_key = 'id'
);

statement ok
INSERT INTO reserved_words VALUES (1, 'asc', 'x');

statement ok
FLUSH;

system ok retry 30 backoff 1s
test "$(starrocks -N -B -e "SELECT count(*) FROM ${STARROCKS_DATABASE}.demo_reserved_words WHERE id = 1 AND \`order\` = 'asc' AND \`from\` = 'x'")" = "1"

statement ok
DROP SINK sink_reserved_words;

statement ok
DROP TABLE reserved_words;

statement ok
CREATE TABLE timestamptz_table (
    id int primary key,
    ts_datetime timestamptz,
    ts_varchar timestamptz,
    ts_char timestamptz,
    ts_string timestamptz
);

statement ok
SET TIME ZONE 'Asia/Shanghai';

statement ok
CREATE SINK sink_timestamptz_table
FROM timestamptz_table
WITH (
    ${RISEDEV_STARROCKS_WITH_OPTIONS_COMMON},
    type = 'upsert',
    starrocks.table = 'demo_timestamptz_table',
    primary_key = 'id'
);

statement ok
INSERT INTO timestamptz_table VALUES (
    1,
    '2018-01-26T18:30:09Z',
    '2018-01-26T18:30:09Z',
    '2018-01-26T18:30:09Z',
    '2018-01-26T18:30:09Z'
);

statement ok
FLUSH;

system ok retry 30 backoff 1s
starrocks -N -B -e "SELECT * FROM ${STARROCKS_DATABASE}.demo_timestamptz_table WHERE id = 1" | awk -F '\t' '$1 == 1 && $2 ~ /^2018-01-27 02:30:09/ && $3 == "2018-01-27 02:30:09.000000" && $4 ~ /^2018-01-27 02:30:09.000000 *$/ && $5 == "2018-01-27 02:30:09.000000" { found = 1 } END { exit !found }'

statement ok
DROP SINK sink_timestamptz_table;

statement ok
DROP TABLE timestamptz_table;

system ok
starrocks -e "
DROP DATABASE IF EXISTS ${STARROCKS_DATABASE};
DROP USER IF EXISTS '${STARROCKS_USER}'@'%';
DROP USER IF EXISTS 'users_no_bhv_table_priv'@'%';
"
